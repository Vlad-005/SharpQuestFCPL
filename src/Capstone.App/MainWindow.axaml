<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Capstone.App.MainWindow"
        Title="Inventory Chest"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="14" Background="#171717">
      <Grid>
        <TextBlock Text="Inventory Chest"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />
        <Button x:Name="InventoryButton"
                Content="Inventory"
                HorizontalAlignment="Right"
                Width="110"
                Height="36" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="#252525">
      <Button x:Name="ChestButton"
              Width="220"
              Height="180"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="0"
              BorderThickness="4"
              BorderBrush="#A07840"
              CornerRadius="12"
              Background="#6B4A2A">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="CHEST"
                     Foreground="#FFF1C4"
                     FontSize="24"
                     FontWeight="Bold"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="ChestCountText"
                     Foreground="White"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border x:Name="InventoryPanel"
              Width="330"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="0,20,20,20"
              Background="#202020"
              CornerRadius="10"
              BorderBrush="#555"
              BorderThickness="1"
              IsVisible="False">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Inventory"
                     Foreground="White"
                     FontSize="18"
                     FontWeight="Bold"
                     Margin="0,0,0,10" />

          <Grid Grid.Row="1">
            <ListBox x:Name="InventoryList"
                     Background="#2A2A2A"
                     BorderBrush="#555"
                     Margin="0" />
          </Grid>

          <Button x:Name="CloseInventoryButton"
                  Grid.Row="2"
                  Content="Close"
                  Margin="0,12,0,0"
                  HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <Border x:Name="ChestPanel"
              Width="430"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="0,20,20,20"
              Background="#202020"
              CornerRadius="10"
              BorderBrush="#555"
              BorderThickness="1"
              IsVisible="False">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="Chest Inventory"
                     Foreground="White"
                     FontSize="18"
                     FontWeight="Bold"
                     Margin="0,0,0,10" />

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="8">
              <TextBlock Text="My Inventory"
                         Foreground="White"
                         FontWeight="Bold" />
              <ListBox x:Name="ChestDepositList"
                       Background="#2A2A2A"
                       BorderBrush="#555"
                       Height="320" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="8">
              <TextBlock Text="Chest"
                         Foreground="White"
                         FontWeight="Bold" />
              <ListBox x:Name="ChestList"
                       Background="#2A2A2A"
                       BorderBrush="#555"
                       Height="320" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8"
                Margin="0,12,0,0">
            <Button x:Name="DepositButton"
                    Grid.Column="0"
                    Content="Deposit" />
            <Button x:Name="WithdrawButton"
                    Grid.Column="1"
                    Content="Withdraw" />
            <Button x:Name="CloseChestButton"
                    Grid.Column="2"
                    Content="Close" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
